<div class="card-body bg-white p-3">
  <form action="/aircraft" method="post">
  <div class="row">
    <div class="col-md-4 col-sm-12">
      <div class="mb-3">
        <label for="">Model Number</label>
        <input
          type="text"
          name="model"
          placeholder="Model Number"
          class="form-control"
          id=""
          required
        />
      </div>
    </div>
    <div class="col-md-4 col-sm-12">
      <div class="mb-3">
        <label for="">Registration</label>
        <input
          type="text"
          name="registration"
          placeholder="Registration "
          class="form-control"
          id=""
          required
        />
      </div>
    </div>
    <div class="col-md-4 col-sm-12">
      <div class="mb-3">
        <label for="">Seat Capacity</label>
        <input
          type="number"
          name="seatingCapacity"
          placeholder="Seat Capacity"
          class="form-control"
          id=""
          required
        />
      </div>
    </div>
  </div>

  <div class="mb-3">
    <input type="submit" value="Register Air Craft" class="btn btn-primary" />
  </div>
  </form>
</div>
