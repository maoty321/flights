<div class="card">
  <div class="card-body table-responsive" style="height: 60vh">
    <table
      id="selection-datatable"
      class="table dt-responsive nowrap w-100 mb-0"
    >
      <thead>
        <tr>
          <th>S?N</th>
          <th>Model</th>
          <th>Registration</th>
          <th>Seat Capacity</th>
        </tr>
      </thead>
      <tbody>
        <% let a = 1; %>
        <% if (aircrafts && aircrafts.length !== 0) { %> <%
        aircrafts.forEach(aircraft => { %>
        <tr>
          <td><%- a++ %></td>
          <td><%- aircraft.model %></td>
          <td><%- aircraft.registration %></td>
          <td><%- aircraft.seatingCapacity %></td>
        </tr>

        <% }) %> <% }  %>
       </tbody>
    </table>
  </div>
  <!-- end card body-->
</div>
