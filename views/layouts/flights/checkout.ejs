<style>

    .top {
        padding-top: 80px;
    }

    .checkout-container {
        width: 75%;
        margin: auto;
        background-color: #fff;
        border-radius: 12px;
        padding: 40px 30px;
        box-shadow: 0 0px 30px rgba(0, 0, 0, 0.1);
    }

    .checkout-title {
        text-align: center;
        font-size: 2rem;
        color: #007bff;
        margin-bottom: 30px;
        letter-spacing: 1px;
    }

    .checkout-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .checkout-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 10px;
    }

    .checkout-label {
        font-weight: 600;
        color: #333;
        flex: 1;
    }

    .checkout-value {
        flex: 2;
        color: #555;
        text-align: left;
    }

    .fullname-list {
        display: flex;
        flex-direction: row;
        padding: 20px;
    }

    .fullname-item {
        margin-bottom: 5px;
    }
    .d {
        margin: 30px;
    }
    .payments {
        text-align: right;
    }
    .btn1 {
        
        padding: 15px;
        border-radius: 10px;
        color: white;
        text-align: right;
        float: right;
        background-color: #007bff;
    }
    @media (width< 600px) {
        .checkout-containe {
            width: 95%;
        }
        .checkout-row {
            flex-direction: column;
            align-items: flex-start;
            padding-bottom: 15px;
        }

        .checkout-value {
            text-align: left;
            margin-top: 5px;
        }

        .fullname-list {
            align-items: flex-start;
        }
    }
</style>

<% if (!alertMsg) { %>
    <div class="top"></div>
    <div class="checkout-container">
        <h2 class="checkout-title">Checkout Summary</h2>
        <div class="checkout-section">

            <div class="checkout-row">
                <div class="checkout-label">Full Name(s):</div>
                <div class="checkout-value fullname-list">
                    <% passenger.fullname.forEach(function(name) { %>
                        <div class="checkout-value"><%= name + ',' + ' ' %></div>
                    <% }); %>
                </div>
            </div>


            <div class="checkout-row">
                <div class="checkout-label">Email for Payment:</div>
                <div class="checkout-value"><%=passenger.email[0] %> </div>
            </div>

             <div class="checkout-row">
                <div class="checkout-label">Departure:</div>
                <div class="checkout-value"><%= fligth_detail.departure %> </div>
            </div>

            <div class="checkout-row">
                <div class="checkout-label">Arrival:</div>
                <div class="checkout-value"><%= fligth_detail.arrival %></div>
            </div>

            <div class="checkout-row">
                <div class="checkout-label">Total Price(NGN):</div>
                <div class="checkout-value"><%= total_price.toLocaleString('en-NG', { style: 'currency', currency: 'NGN' })  %></div>
            </div>

            <div class="payments">
                <a href="/siwesFlight/payment" class="btn1">Proceed to Make Payment</a>
            </div>
        </div>
    </div>
    <div class="d"></div>
<% } %>
