<section class="home" id="home">
      <div class="con">
            <p class="head-title">Explore Our <span style="color: blue"><b>Destinations</b></span></p>
            <p class="head-desc" ><b>Lorem ipsum dolor sit amet consectetur adipisicing elit. Iure, explicabo distinctio!</b></p> <br>
            <button class="btn">Book Now</button>
      </div>
    </section>

    <% if (alertMsg) { %>
     
    <% } else { %>
    <section class="book-ticket" id="book">
        <div class="container">
            <span><i class="ri-flight-takeoff-line"></i> Book flight</span>
            <form action="/siwesflight" method="post">

                <div class="col" style="display: flex;">
                    <div class="mb-1" style="padding-right: 20px;">
                        <input type="radio" name="one_way" id="one_way" checked readonly>
                        <label for="one_way">One Way</label>
                    </div>

                    <!-- <div class="mb-1">
                        <input type="radio" name="one_way" id="round_tip">
                        <label for="round_tip">Round Trip</label>
                    </div> -->
                </div>

                <div class="col-input">
                    <div class="mb-3">
                        <select name="departure" id="" required>
                            <option value="">Departure Airport</option>
                            <% airports.forEach(airport => { %>
                                <option value="<%- airport.name %>"><%- airport.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <select name="arrival" id="" required>
                            <option value="">Arrival Airport</option>
                             <% airports.forEach(airport => { %>
                                <option value="<%- airport.name %>"><%- airport.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <input type="date" name="depatureDate" id="" required>
                    </div>
                </div>
                <div class="col-input">
                    <div class="mb-3">
                        <select name="adult" id="" required>
                            <option value="1">1 Adult(12 yrs+)</option>
                            <option value="2">2 Adult(12 yrs+)</option>
                            <option value="3">3 Adult(12 yrs+)</option>
                            <option value="4">4 Adult(12 yrs+)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <select name="child" id="">
                            <option value="0" >0 Child</option>
                            <option value="1">1 Child</option>
                            <option value="2">2 Child</option>
                            <option value="3">3 Child</option>
                            <option value="4">4 Child</option>
                            <option value="5">5 Child</option>
                            <option value="6">6 Child</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <select name="infact" id="" required>
                            <option value="0">0 Infact (< 2 years)</option>
                            <option value="1">1 Infact (< 2 years)</option>
                            <option value="2">1 Infact (< 2 years)</option>
                            <option value="3">3 Infact (< 2 years)</option>
                        </select>
                    </div>
                </div>
                <input type="submit" value="Search Flights">
            </form>
        </div>
    </section>
    
    <section class="discover" id="destionation">
        <div class="discover-header">
            <h4 class="head-title">Popular Destination</h4>
            <p>Discover the  most Loved Destination Arround the Globe</p>
        </div>
        <div class="discover-body">
            <div class="card">
                <div class="card-img">
                    <img src="/./img/priscilla-du-preez-KoF1cXdF9Ws-unsplash.jpg" alt="">
                </div>
                <div class="card-body">
                    <h4 class="card-title">Tradition and Futurism</h4>
                    <p>New York City, USA</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img">
                    <img src="/./img/il-vagabiondo-8eNt0CQamB0-unsplash.jpg" alt="">
                </div>
                <div class="card-body">
                    <h4 class="card-title">Tradition and Futurism</h4>
                    <p>New York City, USA</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img">
                    <img src="/./img/ammie-ngo-vcu-OZBxxRk-unsplash.jpg" alt="">
                </div>
                <div class="card-body">
                    <h4 class="card-title">Tradition and Futurism</h4>
                    <p>New York City, USA</p>
                </div>
            </div>
        </div>
    </section>

   
<% } %>