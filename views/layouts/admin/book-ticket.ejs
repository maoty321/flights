<div class="card">
  <div class="card-body table-responsive" style="height: 60vh">
    <table
      id="selection-datatable"
      class="table dt-responsive nowrap w-100 mb-0"
    >
      <thead>
        <tr>
          <th>Ticket ID</th>
          <th>Flight Number</th>
          <th>Number of Ticket</th>
          <th>Depature</th>
          <th>Arrival</th>
          <!-- <th>Fares</th> -->
          <th>Action</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody>
         <% let a = 1; %>
        <% if (tickets || tickets.lenght == 0) { %>
              <% tickets.forEach(book_ticket => { %>
                   <tr>
                        <td><%- book_ticket.booking.flight.reference %></td>
                        <td><%- book_ticket.booking.flight.flight_number %></td>
                        <td>3</td>
                        <td><%- book_ticket.flights.departure %></td>
                        <td><%- book_ticket.flights.arrival %></td>
                         <td>
                        <a href="" class="btn text-primary"><i class="ri-eye-line"></i></a>
                      </td>
                      <td><a href="" class="btn text-danger"><i class="ri-delete-bin-6-line"></i></a></td>
                    </tr>
                   </tr>
              <% }) %>
        <% } %>
      </tbody>
    </table>   
  </div>
  <!-- end card body-->
</div>
